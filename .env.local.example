# Supabase — copy to .env.local and fill with your project values
# Get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only — never expose to client. Used in server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# App URL (used by auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — ringkasan AI profil talent (dibuat saat admin menyetujui profil).
# Kosongkan untuk menonaktifkan fitur ini.
ANTHROPIC_API_KEY=

# Optional — email notifikasi (undangan, undangan diterima, hasil review) via Resend.
# EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend. Kosongkan untuk menonaktifkan.
RESEND_API_KEY=
EMAIL_FROM="Portora.id <noreply@portora.id>"

# Email kontak yang tampil di Kebijakan Privasi & Syarat Layanan.
NEXT_PUBLIC_SUPPORT_EMAIL=
